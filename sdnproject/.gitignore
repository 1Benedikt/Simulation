# Build output (created by ./sdn.sh build / opp_makemake+make)
out/

# Generated Makefile: opp_makemake bakes in absolute, machine-specific
# INET include/lib paths (see sdn.sh build_project()). Regenerate with
# ./sdn.sh build instead of committing it.
src/Makefile

# Compiled executables (opp_makemake symlinks these into src/ from out/)
src/sdnproject
src/sdnproject_dbg
sdnproject
sdnproject_dbg

# Object/dependency files, in case a build ever runs outside out/
*.o
*.obj
*.d
*.so
*.dylib
*.dll
*.exe
*.a
*.lib
*.pdb
.last-copts

# Simulation results (regenerated by running configs)
simulations/results/
*.sca
*.vec
*.vci
*.vci2
*.elog
*.anf.bak

# IDE indexing/build scratch
.metadata/

# macOS
.DS_Store
__MACOSX/
